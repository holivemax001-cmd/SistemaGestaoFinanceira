@page
@model SistemaGestaoFinanceira.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Gestão Financeira - Login</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #17345f 0%,
                    #0d2345 45%,
                    #07172f 100%
                );

            color: #172033;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* =========================================
           FUNDO GEOMÃ‰TRICO
           ========================================= */

        .login-background {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .shape {
            position: absolute;
            opacity: 0.16;
            transform: rotate(30deg);
        }

        .shape-one {
            width: 420px;
            height: 420px;
            background: #496b9f;
            top: -180px;
            left: -100px;

            clip-path: polygon(
                0 0,
                100% 0,
                70% 100%,
                0 75%
            );
        }

        .shape-two {
            width: 520px;
            height: 520px;
            background: #5f7fac;
            right: -230px;
            top: -160px;

            clip-path: polygon(
                30% 0,
                100% 20%,
                70% 100%,
                0 75%
            );
        }

        .shape-three {
            width: 460px;
            height: 460px;
            background: #385b8f;
            left: -220px;
            bottom: -220px;

            clip-path: polygon(
                0 20%,
                80% 0,
                100% 75%,
                20% 100%
            );
        }

        .shape-four {
            width: 400px;
            height: 400px;
            background: #274a7c;
            right: -160px;
            bottom: -180px;

            clip-path: polygon(
                25% 0,
                100% 30%,
                75% 100%,
                0 65%
            );
        }

        /* =========================================
           ÃREA PRINCIPAL
           ========================================= */

        .login-wrapper {
            position: relative;
            z-index: 2;
            min-height: 100vh;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            padding: 50px 20px;
        }

        /* =========================================
           CARD
           ========================================= */

        .login-card {
            width: 100%;
            max-width: 500px;

            background: rgba(255, 255, 255, 0.98);

            border-radius: 16px;

            padding: 42px 46px 38px;

            box-shadow:
                0 25px 60px rgba(0, 0, 0, 0.35);

            backdrop-filter: blur(5px);
        }

        /* =========================================
           TÃTULO
           ========================================= */

        .login-brand {
            text-align: center;

            font-size: 29px;
            font-weight: 700;

            color: #101820;

            margin-bottom: 22px;
        }

        .login-title {
            text-align: center;

            font-size: 28px;
            font-weight: 600;

            color: #101820;

            margin-bottom: 7px;
        }

        .login-subtitle {
            text-align: center;

            font-size: 16px;

            color: #6b7280;

            margin-bottom: 32px;
        }

        /* =========================================
           CAMPOS
           ========================================= */

        .login-label {
            display: block;

            font-size: 15px;
            font-weight: 600;

            color: #20252b;

            margin-bottom: 9px;
        }

        .login-input-wrapper {
            position: relative;

            margin-bottom: 20px;
        }

        .login-input-icon {
            position: absolute;

            left: 15px;
            top: 50%;

            transform: translateY(-50%);

            color: #8994a3;

            font-size: 18px;

            z-index: 2;
        }

        .login-input {
            width: 100%;

            height: 50px;

            border: 1px solid #adb7c4;

            border-radius: 8px;

            padding: 10px 14px 10px 45px;

            font-size: 15px;

            color: #20252b;

            background: #ffffff;

            outline: none;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .login-input:focus {
            border-color: #2f80ed;

            box-shadow:
                0 0 0 4px rgba(47, 128, 237, 0.15);
        }

        /* =========================================
           LEMBRAR-ME
           ========================================= */

        .remember-container {
            display: flex;

            align-items: center;

            gap: 9px;

            margin: 6px 0 25px;
        }

        .remember-container input[type="checkbox"] {
            width: 18px;
            height: 18px;

            accent-color: #2f80ed;

            cursor: pointer;
        }

        .remember-container label {
            font-size: 15px;

            color: #30353b;

            cursor: pointer;
        }

        /* =========================================
           BOTÃƒO
           ========================================= */

        .login-button {
            width: 100%;

            height: 50px;

            border: none;

            border-radius: 8px;

            background:
                linear-gradient(
                    180deg,
                    #3398f3 0%,
                    #2682e5 100%
                );

            color: white;

            font-size: 16px;

            font-weight: 600;

            cursor: pointer;

            box-shadow:
                0 7px 16px rgba(38, 130, 229, 0.30);

            transition:
                transform 0.15s ease,
                box-shadow 0.15s ease;
        }

        .login-button:hover {
            transform: translateY(-1px);

            box-shadow:
                0 9px 19px rgba(38, 130, 229, 0.35);
        }

        /* =========================================
           ERROS
           ========================================= */

        .login-error {
            background: #fff1f2;

            border: 1px solid #fecdd3;

            color: #b42318;

            border-radius: 8px;

            font-size: 14px;

            padding: 12px;

            margin-bottom: 20px;
        }

        .field-validation-error {
            display: block;

            color: #b42318;

            font-size: 12px;

            margin-top: 4px;
        }

        /* =========================================
           RODAPÃ‰
           ========================================= */

        .login-footer {
            color: rgba(255, 255, 255, 0.82);

            font-size: 13px;

            margin-top: 35px;

            text-align: center;
        }

        .login-footer a {
            color: white;

            text-decoration: none;
        }

        .login-footer a:hover {
            text-decoration: underline;
        }

        /* =========================================
           RESPONSIVO
           ========================================= */

        @@media (max-width: 600px) {

            .login-wrapper {
                padding: 30px 15px;
            }

            .login-card {
                max-width: 100%;

                padding: 32px 25px 30px;

                border-radius: 14px;
            }

            .login-brand {
                font-size: 24px;
            }

            .login-title {
                font-size: 24px;
            }

            .login-subtitle {
                font-size: 14px;
            }
        }
    

        /* FINTRUST - Icones dos campos de login */
        .login-input-icon.icon-email,
        .login-input-icon.icon-lock {
            display: inline-block;
            width: 18px;
            height: 18px;
            font-size: 0;
            box-sizing: border-box;
        }

        /* Envelope */
        .login-input-icon.icon-email {
            height: 13px;
            border: 1.8px solid #8994a3;
            border-radius: 3px;
        }

        .login-input-icon.icon-email::after {
            content: "";
            position: absolute;
            left: 2px;
            top: -1px;
            width: 10px;
            height: 7px;
            border-right: 1.8px solid #8994a3;
            border-bottom: 1.8px solid #8994a3;
            transform: rotate(45deg);
        }

        /* Cadeado */
        .login-input-icon.icon-lock {
            width: 15px;
            height: 12px;
            margin-top: 4px;
            border: 1.8px solid #8994a3;
            border-radius: 3px;
        }

        .login-input-icon.icon-lock::before {
            content: "";
            position: absolute;
            left: 2px;
            top: -9px;
            width: 7px;
            height: 9px;
            border: 1.8px solid #8994a3;
            border-radius: 7px 7px 0 0;
            border-bottom: 0;
        }

</style>

</head>

<body>

    <!-- FUNDO -->

    <div class="login-background">

        <div class="shape shape-one"></div>
        <div class="shape shape-two"></div>
        <div class="shape shape-three"></div>
        <div class="shape shape-four"></div>

    </div>

    <!-- CONTEÃšDO -->

    <div class="login-wrapper">

        <div class="login-card">

            <!-- MARCA -->

            <div class="login-brand">
                Gestão Financeira
            </div>

            <!-- TÃTULO -->

            <div class="login-title">
                Bem-vindo de volta
            </div>

            <div class="login-subtitle">
                Inicie sessão para gerir as suas finanças
            </div>

            <!-- ERROS -->

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="login-error">

                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        <div>
                            @error.ErrorMessage
                        </div>
                    }

                </div>
            }

            <!-- FORMULÃRIO -->

            <form method="post"
                  asp-route-returnUrl="@Model.ReturnUrl">

                @Html.AntiForgeryToken()

                <!-- EMAIL -->

                <label for="Input_Email"
                       class="login-label">
                    E-mail
                </label>

                <div class="login-input-wrapper">

                    <span class="login-input-icon icon-email" aria-hidden="true"></span>

                    <input id="Input_Email"
                           name="Input.Email"
                           type="email"
                           class="login-input"
                           autocomplete="username"
                           value="@Model.Input.Email" />

                </div>

                <span asp-validation-for="Input.Email"
                      class="field-validation-error">
                </span>

                <!-- SENHA -->

                <label for="Input_Password"
                       class="login-label">
                    Senha
                </label>

                <div class="login-input-wrapper">

                    <span class="login-input-icon icon-lock" aria-hidden="true"></span>

                    <input id="Input_Password"
                           name="Input.Password"
                           type="password"
                           class="login-input"
                           autocomplete="current-password" />

                </div>

                <span asp-validation-for="Input.Password"
                      class="field-validation-error">
                </span>

                <!-- LEMBRAR -->

                <div class="remember-container">

                    <input id="Input_RememberMe"
                           name="Input.RememberMe"
                           type="checkbox"
                           value="true" />

                    <input type="hidden"
                           name="Input.RememberMe"
                           value="false" />

                    <label for="Input_RememberMe">
                        Lembrar-me
                    </label>

                </div>

                <!-- BOTÃƒO -->

                <button type="submit"
                        class="login-button">
                    Entrar
                </button>

            </form>

        </div>

        <!-- RODAPÃ‰ -->

        <div class="login-footer">

            © @DateTime.Now.Year - Gestão Financeira -

            <a asp-page="/Privacy">
                Privacidade
            </a>

        </div>

    </div>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>
