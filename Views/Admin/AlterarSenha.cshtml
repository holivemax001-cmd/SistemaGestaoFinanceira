@{
    ViewData["Title"] = "Alterar senha";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header">
                    <h4 class="mb-0">Alterar senha</h4>
                </div>

                <div class="card-body">

                    <div class="mb-4">
                        <label class="form-label">
                            Usuário
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@ViewBag.Email"
                               readonly />
                    </div>

                    <form asp-action="AlterarSenha"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@ViewBag.UsuarioId" />

                        <div class="mb-3">
                            <label for="novaSenha"
                                   class="form-label">
                                Nova senha
                            </label>

                            <input type="password"
                                   id="novaSenha"
                                   name="novaSenha"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required />

                            <div class="form-text">
                                Mínimo de 6 caracteres, contendo
                                letra maiúscula, letra minúscula
                                e número.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="confirmarSenha"
                                   class="form-label">
                                Confirmar nova senha
                            </label>

                            <input type="password"
                                   id="confirmarSenha"
                                   name="confirmarSenha"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required />
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var erro in ViewData.ModelState.Values
                                        .SelectMany(v => v.Errors))
                                    {
                                        <li>@erro.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Alterar senha
                            </button>

                            <a asp-action="Usuarios"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>