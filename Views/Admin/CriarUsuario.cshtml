
@{
    ViewData["Title"] = "Novo Usuário";
    var clientes = ViewBag.Clientes
        as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Novo Usuário</h1>
            <p class="text-muted mb-0">
                Cadastre um usuário e vincule-o a uma empresa.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Usuarios"
           class="btn btn-secondary">
            Voltar
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Dados do usuário</h5>
                </div>

                <div class="card-body">
                    <form asp-controller="Admin"
                          asp-action="CriarUsuario"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label for="nome" class="form-label">
                                Nome
                            </label>
                            <input type="text"
                                   id="nome"
                                   name="nome"
                                   class="form-control"
                                   maxlength="150"
                                   autocomplete="name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label for="clienteId" class="form-label">
                                Empresa
                            </label>

                            <select id="clienteId"
                                    name="clienteId"
                                    class="form-select"
                                    required>
                                <option value="">Selecione uma empresa</option>
                                @foreach (var cliente in clientes)
                                {
                                    <option value="@cliente.Value">
                                        @cliente.Text
                                    </option>
                                }
                            </select>

                            <div class="form-text">
                                O usuário ficará vinculado à empresa selecionada.
                            </div>

                            @Html.ValidationMessage(
                                "clienteId",
                                null,
                                new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                E-mail
                            </label>
                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control"
                                   autocomplete="username"
                                   required />
                            @Html.ValidationMessage(
                                "email",
                                null,
                                new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">
                                Senha
                            </label>
                            <input type="password"
                                   id="senha"
                                   name="senha"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required />
                            <div class="form-text">
                                Mínimo de 6 caracteres, com letra maiúscula,
                                letra minúscula e número.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="confirmarSenha" class="form-label">
                                Confirmar senha
                            </label>
                            <input type="password"
                                   id="confirmarSenha"
                                   name="confirmarSenha"
                                   class="form-control"
                                   autocomplete="new-password"
                                   required />
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var erro in ViewData.ModelState.Values
                                        .SelectMany(v => v.Errors))
                                    {
                                        <li>@erro.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Criar usuário
                            </button>

                            <a asp-controller="Admin"
                               asp-action="Usuarios"
                               class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
