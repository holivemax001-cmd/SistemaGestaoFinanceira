@model SistemaGestaoFinanceira.Models.ContaFinanceira

@{
    ViewData["Title"] = "Editar Conta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Editar Conta</h1>
        <p class="text-muted">Altere os dados da conta financeira.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Voltar
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DataCadastro" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                @if (User.IsInRole("Admin"))
                {
                    <div class="col-md-6">
                        <label asp-for="ClienteId" class="form-label">
                            Cliente
                        </label>

                        <select asp-for="ClienteId" class="form-select" required>
                            <option value="">Selecione o cliente</option>

                            @if (ViewBag.Clientes != null)
                            {
                                foreach (var cliente in ViewBag.Clientes)
                                {
                                    <option value="@cliente.Id">
                                        @cliente.Nome
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="ClienteId"
                              class="text-danger"></span>
                    </div>
                }

                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label">
                        Nome da conta
                    </label>
                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Ex.: Conta Corrente" />
                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label">
                        Tipo
                    </label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="Conta Corrente">Conta Corrente</option>
                        <option value="Conta Poupança">Conta Poupança</option>
                        <option value="Carteira">Carteira</option>
                        <option value="Conta Digital">Conta Digital</option>
                        <option value="Investimento">Investimento</option>
                        <option value="Outro">Outro</option>
                    </select>
                    <span asp-validation-for="Tipo"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Instituicao" class="form-label">
                        Instituição
                    </label>
                    <input asp-for="Instituicao"
                           class="form-control"
                           placeholder="Ex.: Banco Inter" />
                    <span asp-validation-for="Instituicao"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SaldoInicial" class="form-label">
                        Saldo inicial
                    </label>
                    <input asp-for="SaldoInicial"
                           class="form-control"
                           type="number"
                           step="0.01" />
                    <span asp-validation-for="SaldoInicial"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Observacao" class="form-label">
                        Observação
                    </label>
                    <textarea asp-for="Observacao"
                              class="form-control"
                              rows="3"
                              placeholder="Observações sobre a conta"></textarea>
                    <span asp-validation-for="Observacao"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Ativa"
                               class="form-check-input" />
                        <label asp-for="Ativa"
                               class="form-check-label">
                            Conta ativa
                        </label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Salvar alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}