@model IEnumerable<SistemaGestaoFinanceira.Models.ContaFinanceira>

@{
    ViewData["Title"] = "Contas Financeiras";
    var ehAdmin = User.IsInRole("Admin");
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Contas Financeiras</h1>
            <p class="text-muted">Gerencie suas contas e saldos.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nova Conta
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Erro"]
                </div>
            }

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Sucesso"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>Nenhuma conta cadastrada</h5>

                    <p class="text-muted">
                        Comece cadastrando sua primeira conta financeira.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Cadastrar primeira conta
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                @if (ehAdmin)
                                {
                                    <th>Cliente</th>
                                }

                                <th>Nome</th>
                                <th>Tipo</th>
                                <th>Instituição</th>
                                <th>Saldo Inicial</th>
                                <th>Receitas</th>
                                <th>Despesas</th>
                                <th>Saldo Atual</th>
                                <th>Status</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var conta in Model)
                            {
                                var receitas =
                                    (decimal?)ViewData[$"Receitas_{conta.Id}"] ?? 0;

                                var despesas =
                                    (decimal?)ViewData[$"Despesas_{conta.Id}"] ?? 0;

                                var saldoAtual =
                                    (decimal?)ViewData[$"SaldoAtual_{conta.Id}"] ?? 0;

                                <tr>
                                    @if (ehAdmin)
                                    {
                                        <td>
                                            @(conta.Cliente?.Nome ?? "Sem cliente")
                                        </td>
                                    }

                                    <td>
                                        <strong>@conta.Nome</strong>
                                    </td>

                                    <td>@conta.Tipo</td>

                                    <td>@(conta.Instituicao ?? "-")</td>

                                    <td>@conta.SaldoInicial.ToString("C2")</td>

                                    <td class="text-success fw-semibold">
                                        @receitas.ToString("C2")
                                    </td>

                                    <td class="text-danger fw-semibold">
                                        @despesas.ToString("C2")
                                    </td>

                                    <td class="fw-bold">
                                        @saldoAtual.ToString("C2")
                                    </td>

                                    <td>
                                        @if (conta.Ativa)
                                        {
                                            <span class="badge bg-success">
                                                Ativa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativa
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@conta.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Tem certeza que deseja excluir esta conta?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@conta.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Excluir
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>