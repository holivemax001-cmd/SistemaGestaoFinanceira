 @model SistemaGestaoFinanceira.Models.ContaFinanceira

@{
    ViewData["Title"] = "Nova Conta";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="fw-bold mb-1">Nova Conta</h2>
                <p class="text-muted mb-4">
                    Cadastre uma conta financeira.
                </p>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label">
                                Cliente
                            </label>

                            <select asp-for="ClienteId"
                                    class="form-select"
                                    required>
                                <option value="">Selecione o cliente</option>
                                @if (ViewBag.Clientes != null)
                                {
                                    foreach (var cliente in ViewBag.Clientes)
                                    {
                                        <option value="@cliente.Id">
                                            @cliente.Nome
                                        </option>
                                    }
                                }
                            </select>

                            <span asp-validation-for="ClienteId"
                                  class="text-danger"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">
                            Nome da conta
                        </label>
                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Ex.: Conta Nubank" />
                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tipo" class="form-label">
                            Tipo
                        </label>
                        <select asp-for="Tipo" class="form-select">
                            <option value="">Selecione</option>
                            <option value="Conta Corrente">Conta Corrente</option>
                            <option value="Conta Poupança">Conta Poupança</option>
                            <option value="Carteira">Carteira</option>
                            <option value="Conta Digital">Conta Digital</option>
                            <option value="Investimento">Investimento</option>
                            <option value="Outro">Outro</option>
                        </select>
                        <span asp-validation-for="Tipo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Instituicao" class="form-label">
                            Instituição
                        </label>
                        <input asp-for="Instituicao"
                               class="form-control"
                               placeholder="Ex.: Nubank" />
                        <span asp-validation-for="Instituicao"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SaldoInicial" class="form-label">
                            Saldo inicial
                        </label>
                        <input asp-for="SaldoInicial"
                               class="form-control"
                               type="number"
                               step="0.01" />
                        <span asp-validation-for="SaldoInicial"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observacao" class="form-label">
                            Observação
                        </label>
                        <textarea asp-for="Observacao"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Observações sobre a conta"></textarea>
                        <span asp-validation-for="Observacao"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Salvar Conta
                        </button>
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}