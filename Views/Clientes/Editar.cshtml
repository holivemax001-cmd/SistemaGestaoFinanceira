@model SistemaGestaoFinanceira.Models.Cliente

@{
    ViewData["Title"] = "Editar cliente";
}

<div class="container mt-4">
    <h2 class="mb-2">Editar cliente</h2>
    <p class="text-muted">Altere os dados do cliente cadastrado.</p>

    <div class="card mt-4">
        <div class="card-body">
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome do cliente
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           maxlength="150"
                           required />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Ativo"
                           class="form-check-input" />

                    <label asp-for="Ativo" class="form-check-label">
                        Cliente ativo
                    </label>

                    <div class="form-text">
                        Desmarque para desativar o cliente sem apagar
                        seus dados financeiros.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Salvar alterações
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Voltar
                </a>
            </form>
        </div>
    </div>
</div>
