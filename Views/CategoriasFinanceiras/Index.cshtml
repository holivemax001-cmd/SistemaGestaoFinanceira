@model IEnumerable<SistemaGestaoFinanceira.Models.CategoriaFinanceira>

@{
    ViewData["Title"] = "Categorias";
    var ehAdmin = User.IsInRole("Admin");
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Categorias</h1>
            <p class="text-muted mb-0">
                Gerencie suas categorias financeiras.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nova Categoria
        </a>
    </div>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            @if (ehAdmin)
                            {
                                <th>Cliente</th>
                            }

                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Descrição</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="@(ehAdmin ? 6 : 5)"
                                    class="text-center text-muted py-4">
                                    Nenhuma categoria cadastrada.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var categoria in Model)
                            {
                                <tr>
                                    @if (ehAdmin)
                                    {
                                        <td>
                                            @(categoria.Cliente?.Nome ?? "Sem cliente")
                                        </td>
                                    }

                                    <td>
                                        <strong>@categoria.Nome</strong>
                                    </td>

                                    <td>
                                        @if (categoria.Tipo == "Receita")
                                        {
                                            <span class="badge bg-success">
                                                Receita
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Despesa
                                            </span>
                                        }
                                    </td>

                                    <td>@categoria.Descricao</td>

                                    <td>
                                        @if (categoria.Ativa)
                                        {
                                            <span class="badge bg-success">
                                                Ativa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inativa
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@categoria.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Editar
                                            </a>

                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="m-0"
                                                  onsubmit="return confirm('Tem certeza que deseja excluir esta categoria?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@categoria.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Excluir
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>