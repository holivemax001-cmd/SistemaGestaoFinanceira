@model SistemaGestaoFinanceira.Models.CategoriaFinanceira

@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h2 class="fw-bold mb-1">Nova Categoria</h2>

                <p class="text-muted mb-4">
                    Cadastre uma categoria financeira.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-3">
                            <label asp-for="ClienteId" class="form-label">
                                Cliente
                            </label>

                            <select asp-for="ClienteId"
                                    class="form-select"
                                    required>
                                <option value="">Selecione o cliente</option>

                                @if (ViewBag.Clientes != null)
                                {
                                    foreach (var cliente in ViewBag.Clientes)
                                    {
                                        <option value="@cliente.Id">
                                            @cliente.Nome
                                        </option>
                                    }
                                }
                            </select>

                            <span asp-validation-for="ClienteId"
                                  class="text-danger"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">
                            Nome da categoria
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Ex.: Salário" />

                        <span asp-validation-for="Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tipo" class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Tipo" class="form-select">
                            <option value="">Selecione</option>
                            <option value="Receita">Receita</option>
                            <option value="Despesa">Despesa</option>
                        </select>

                        <span asp-validation-for="Tipo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descricao" class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Descrição da categoria"></textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Salvar Categoria
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}