@model SistemaGestaoFinanceira.Models.CategoriaFinanceira

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">Editar Categoria</h1>
        <p class="text-muted">
            Altere os dados da categoria financeira.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Voltar
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="DataCadastro" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            @if (User.IsInRole("Admin"))
            {
                <div class="mb-3">
                    <label asp-for="ClienteId" class="form-label">
                        Cliente
                    </label>

                    <select asp-for="ClienteId"
                            class="form-select"
                            required>
                        <option value="">Selecione o cliente</option>

                        @if (ViewBag.Clientes != null)
                        {
                            foreach (var cliente in ViewBag.Clientes)
                            {
                                <option value="@cliente.Id">
                                    @cliente.Nome
                                </option>
                            }
                        }
                    </select>

                    <span asp-validation-for="ClienteId"
                          class="text-danger"></span>
                </div>
            }

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome" class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Tipo" class="form-label">
                        Tipo
                    </label>

                    <select asp-for="Tipo" class="form-select">
                        <option value="Receita">Receita</option>
                        <option value="Despesa">Despesa</option>
                    </select>

                    <span asp-validation-for="Tipo"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Descricao" class="form-label">
                        Descrição
                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="3"></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Ativa"
                               class="form-check-input" />

                        <label asp-for="Ativa"
                               class="form-check-label">
                            Categoria ativa
                        </label>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Salvar Alterações
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}