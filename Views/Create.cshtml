@model SistemaGestaoFinanceira.Models.Despesa

@{
    ViewData["Title"] = "Nova Despesa";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <h2 class="fw-bold mb-1">Nova Despesa</h2>

                <p class="text-muted mb-4">
                    Cadastre uma nova despesa financeira.
                </p>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descricao" class="form-label">
                            Descrição
                        </label>

                        <input asp-for="Descricao"
                               class="form-control"
                               placeholder="Ex.: Conta de energia" />

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Valor" class="form-label">
                            Valor
                        </label>

                        <input asp-for="Valor"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               placeholder="0.00" />

                        <span asp-validation-for="Valor"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Data" class="form-label">
                            Data
                        </label>

                        <input asp-for="Data"
                               class="form-control"
                               type="date" />

                        <span asp-validation-for="Data"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContaFinanceiraId"
                               class="form-label">
                            Conta
                        </label>

                        <select asp-for="ContaFinanceiraId"
                                class="form-select">

                            <option value="">
                                Selecione uma conta
                            </option>

                            @foreach (var conta in ViewBag.Contas)
                            {
                                <option value="@conta.Id">
                                    @conta.Nome
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ContaFinanceiraId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoriaFinanceiraId"
                               class="form-label">
                            Categoria
                        </label>

                        <select asp-for="CategoriaFinanceiraId"
                                class="form-select">

                            <option value="">
                                Selecione uma categoria
                            </option>

                            @foreach (var categoria in ViewBag.Categorias)
                            {
                                <option value="@categoria.Id">
                                    @categoria.Nome
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoriaFinanceiraId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observacao"
                               class="form-label">
                            Observação
                        </label>

                        <textarea asp-for="Observacao"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Observações sobre a despesa"></textarea>
                    </div>

                    <div class="form-check mb-4">

                        <input asp-for="Paga"
                               class="form-check-input" />

                        <label asp-for="Paga"
                               class="form-check-label">
                            Despesa já paga
                        </label>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Salvar Despesa
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}