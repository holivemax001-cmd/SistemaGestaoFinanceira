<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FinTrust
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="d-flex flex-column min-vh-100">

    <!-- =====================================================
         MENU PRINCIPAL
         ===================================================== -->

    <header>

        <nav class="navbar navbar-expand-lg finance-navbar">

            <div class="container-fluid px-4">

                <a class="navbar-brand finance-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="finance-brand-icon">
                        $
                    </span>

                    <span>
                        FinTrust
                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbarPrincipal">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- DASHBOARD -->

                        <li class="nav-item">

                            <a class="nav-link finance-nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>


                        <!-- CONTAS -->

                        <li class="nav-item">

                            <a class="nav-link finance-nav-link"
                               asp-controller="ContasFinanceiras"
                               asp-action="Index">

                                Contas

                            </a>

                        </li>


                        <!-- RECEITAS -->

                        <li class="nav-item">

                            <a class="nav-link finance-nav-link"
                               asp-controller="Receitas"
                               asp-action="Index">

                                Receitas

                            </a>

                        </li>


                        <!-- DESPESAS -->

                        <li class="nav-item">

                            <a class="nav-link finance-nav-link"
                               asp-controller="Despesas"
                               asp-action="Index">

                                Despesas

                            </a>

                        </li>


                        <!-- CATEGORIAS -->

                        <li class="nav-item">

                            <a class="nav-link finance-nav-link"
                               asp-controller="CategoriasFinanceiras"
                               asp-action="Index">

                                Categorias

                            </a>

                        </li>


                        <!-- ADMINISTRAÇÃO -->

                        @if (User.IsInRole("Admin"))
                        {
                            
                        <li class="nav-item">
                            <a class="nav-link finance-nav-link"
                               asp-controller="Clientes"
                               asp-action="Index">
                                Clientes
                            </a>
                        </li>
<li class="nav-item">

                                <a class="nav-link finance-nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    Administração

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- USUÁRIO -->

                    <div class="finance-user-area">

                        <div class="finance-user-icon">
                            👤
                        </div>

                        <div class="finance-user-info">

                            <span class="finance-user-label">
                                Olá,
                            </span>

                            <span class="finance-user-name">
                                @User.Identity?.Name
                            </span>

                        </div>


                        <!-- SAIR -->

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post"
                              class="m-0">

                            <button type="submit"
                                    class="finance-logout">

                                Sair

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================================
         CONTEÚDO
         ===================================================== -->

    <main class="container-fluid py-4 flex-grow-1">

        @RenderBody()

    </main>


    <!-- =====================================================
         RODAPÉ
         ===================================================== -->

    <footer class="border-top footer text-muted mt-auto">

        <div class="container text-center py-3">

            <span>
                © 2026 - FinTrust -
            </span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacidade

            </a>

        </div>

    </footer>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>


